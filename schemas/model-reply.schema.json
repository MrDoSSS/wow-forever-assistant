{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelReply",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "answer",
        "partial",
        "needs_data",
        "error"
      ]
    },
    "text": {
      "description": "Answer shown in the in-game chat, in the language of the question. Write every item from itemRefIds as [[item:<itemRefId>]] in place of its name and every place as [[map:<index>]] into locations: the addon shows them as named links, so never repeat the name next to a marker.",
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "itemRefIds": {
      "description": "itemRefIds from get_game_record (type \"item\") or lookup_items for this question. Get one for every item the answer names, and write each in text as its [[item:<itemRefId>]] marker.",
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{32}$"
      }
    },
    "evidenceIds": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{32}$"
      }
    },
    "locationRefId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "approxLocation": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "zoneName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "basis": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "sourceUrl": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": [
            "title",
            "zoneName",
            "x",
            "y",
            "basis",
            "sourceUrl"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "locations": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "locationRefId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "approxLocation": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "zoneName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "sourceUrl": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                },
                "required": [
                  "title",
                  "zoneName",
                  "x",
                  "y",
                  "basis",
                  "sourceUrl"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "locationRefId",
          "approxLocation"
        ],
        "additionalProperties": false
      }
    },
    "calculationIds": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{32}$"
      }
    },
    "limitations": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "clarification": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        {
          "type": "null"
        }
      ]
    },
    "plan": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "steps": {
              "minItems": 1,
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "get",
                      "craft",
                      "learn",
                      "mail",
                      "collect",
                      "login",
                      "goto",
                      "do"
                    ]
                  },
                  "text": {
                    "description": "Short instruction in the language of the question. Write this step's own item as [[item:<its itemRefId>]] and its own place as [[map:<its location>]] instead of their names; no other markers. The plan window shows them as links and adds progress such as 0/1, so add no labels or owned counts.",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "character": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "itemRefId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f]{32}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "quantity": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "location": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 20
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "mailTo": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "mailFrom": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "moneyCopper": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "recipeSpellId": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2147483647
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "profession": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "skillRank": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 450
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "text",
                  "character",
                  "itemRefId",
                  "quantity",
                  "location",
                  "mailTo",
                  "mailFrom",
                  "moneyCopper",
                  "recipeSpellId",
                  "profession",
                  "skillRank"
                ],
                "additionalProperties": false
              }
            },
            "revisesActivePlan": {
              "type": "boolean"
            }
          },
          "required": [
            "title",
            "steps",
            "revisesActivePlan"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "status",
    "text",
    "itemRefIds",
    "evidenceIds",
    "locationRefId",
    "approxLocation",
    "locations",
    "calculationIds",
    "limitations",
    "clarification",
    "plan"
  ],
  "additionalProperties": false
}
