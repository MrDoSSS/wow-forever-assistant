        "coverage": {
          "type": "string",
          "enum": [
            "complete",
            "partial"
          ]
        },
        "observedAtSessionMs": {
          "$ref": "#/$defs/N"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "api_unavailable",
                "not_ready",
                "partial_limit"
              ]
            },
            {
              "type": "null"
            }
          ]
